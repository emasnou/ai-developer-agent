# ==========================================
# Variables d'Entorn i Secrets (MOLT IMPORTANT)
# ==========================================
.env
*.env
!.env.example

# ==========================================
# Entorns Virtuals de Python
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Fitxers de Codi i Memòria Catxé de Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Coberta de Tests i Fitxers Temporals (PyTest)
# ==========================================
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ==========================================
# Workspaces Aïllats d'Agents i Logs d'Auditoria
# ==========================================
.workspace/
logs/
*.log
*.log.*

# ==========================================
# Distribució i Empaquetat (Python Packaging)
# ==========================================
build/
dist/
*.egg-info/

# ==========================================
# Fitxers de la IDE / Editor de Codi
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Fitxers de Sistema Operatiu
# ==========================================
.DS_Store
Thumbs.db
